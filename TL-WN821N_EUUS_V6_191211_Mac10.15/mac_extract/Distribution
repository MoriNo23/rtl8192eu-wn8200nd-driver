<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <!-- Use 1 for the version used prior to OS X v10.6.6, or 2 after that. -->
    <installation-check script="pm_install_check();"/>
    <options customize="never" allow-external-scripts="false" require-scripts="false"/>
    <domains enable_localSystem="true"/>
    <script>
    function pm_install_check() {
		if(!(system.compareVersions(system.version.ProductVersion,'10.9') &gt;= 0)) {
			my.result.title = system.localizedStringWithFormat('RT_FATAL', '10.9');
			my.result.message = system.localizedStringWithFormat('RT_OSVER', '10.9');
			my.result.type = 'Fatal';
			return false;
		}
		return true;
	}

	function check_os_version(minVer, noMoreThanVer) {
  		var result = true;
		if(system.version.ProductVersion)
		{
 			result = result &amp;&amp;  (system.compareVersions(system.version.ProductVersion, minVer) &gt;= 0);
			if( noMoreThanVer != '0' )
			{
            	result = result &amp;&amp; (system.compareVersions(system.version.ProductVersion, noMoreThanVer) &lt; 0);
            }
            <!--system.log("check_os_version- system.version.ProductVersion:" + system.version.ProductVersion); -->
        <!--system.log("check_os_version- minVer:" + minVer); -->
        <!--system.log("check_os_version- result:" + result); -->
        
		}
  		return result;
	}


	function isFJCP_check_systemRun_Example() {
		result = true;
        
        var bFJCPlocale=system.run('/bin/sh','-c', 'isFJCPlocale=`/usr/bin/defaults read -g AppleLocale | cut -d _ -f 2`; echo isFJCPlocale = $isFJCPlocale; if [ $isFJCPlocale == "US" ] || [ $isFJCPlocale == "JP" ]; then exit 0; else exit 1; fi');
		if( bFJCPlocale != 0) {
			system.log("isFJCP_check_Example: 0");
			result = false;
		} 
		return result; 
	}
    
    function isFJCP_check() {
    	result = false;
    	<!-- system.defaults.Country can't be used, it would be "US" but AppleLocale="en_JP" -->
        <!-- system.log("system.defaults.AppleLocale:"+ system.defaults.AppleLocale); -->
        <!-- system.log("system.defaults.Country:"+ system.defaults.Country); -->
        
    
    	var AppleLocaleStr=system.defaults.AppleLocale;
    	var isFJCPlocale =AppleLocaleStr.split("_");
        system.log("isFJCPlocale[1]:"+ isFJCPlocale[1]);
        
        if( isFJCPlocale[1] == "US" ||
        	isFJCPlocale[1] == "JP" )
        {
        	result = true;
        }
        return result;
    }


	function pm_106_108_FJCP_selected() {
 		result = true;
  		result = result &amp;&amp; (isFJCP_check() == true);
  		result = result &amp;&amp; (my.target.systemVersion &amp;&amp; /* &gt;= */ system.compareVersions(my.target.systemVersion.ProductVersion, '10.6.0') &gt;= 0);
  		result = result &amp;&amp; (my.target.systemVersion &amp;&amp; /* &lt; */ system.compareVersions(my.target.systemVersion.ProductVersion, '10.9.0') &lt; 0);
  		return result;
	}
    
    </script>
